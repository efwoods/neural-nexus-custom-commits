# Config & credentials for the hourly_progress cron job.
# Sourced by ~/.local/bin/hourly_progress_all.sh (which cron runs at :20 and :50).
# Cron does NOT see your interactive shell environment, so the values must live here.
#
# ./install.sh --setup copies this file to ~/.config/hourly_progress.env (chmod 600).
# Keep that copy private and do not commit it.

# The shared avatar/assistant id every worktree posts its progress to.
# Create an avatar at https://api.neuralnexus.site and copy its assistant id here.
AVATAR_ID=""

# Your Neural Nexus API key (hourly_progress.py reads this from the environment).
NN_API_KEY=""

# Absolute path to the folder that holds all of your git worktrees.
# Every immediate subdirectory that contains hourly_progress.py will be processed.
# Example: WT_ROOT="/home/user/gh/anubis-project/wt"
WT_ROOT=""

# Optional. Root that git_log_all.sh recurses to collect raw `git log` for the
# test/dev/main branches of every repo it finds (appended to the day's log and
# uploaded to the avatar at :20/:50). If unset, it defaults to the parent of
# WT_ROOT (e.g. WT_ROOT=.../anubis-project/wt -> GIT_LOG_ROOT=.../anubis-project).
# Example: GIT_LOG_ROOT="/home/user/gh/anubis-project"
GIT_LOG_ROOT=""
